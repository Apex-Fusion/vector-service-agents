{
  "schema": "vector.agent-manifest.v2",
  "name": "Insurer Intake Agent",
  "capability_id": "health.priorauth.intake.v1",
  "version": "0.1.0",
  "description": "For an insurer: takes an authorization request from the agent of a care provider, checks who sent it and that the provider's reviewer signed off exactly this request, decides whether it is complete, files it in the insurer's system and returns an intake record; it makes an intake decision and no coverage decision.",
  "operator": {
    "name": "Apex Fusion Foundation",
    "contact": "<OPERATOR_CONTACT>"
  },
  "identity": {
    "did": "<AGENT_DID>",
    "registry_address": "",
    "supplier_key": "<AGENT_DID>#<SUPPLIER_PKH>"
  },
  "keys": {
    "supplier_pkh": "<SUPPLIER_PKH>",
    "pub_key_hex": "<SUPPLIER_PUB_KEY_HEX>",
    "buyer_pkh": "<INTAKE_SERVICE_PKH>"
  },
  "interface": {
    "request_schema": {
      "type": "object",
      "required": [
        "schema",
        "use_case",
        "sender_did",
        "delegation",
        "document",
        "salt",
        "approval"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "vector.usecase.handoff.v1"
        },
        "use_case": {
          "const": "prior-authorization"
        },
        "sender_did": {
          "type": "string",
          "pattern": "^did:vector:[0-9a-f]{64}$",
          "description": "The DID of the sender: the agent of the care provider that hires this agent"
        },
        "delegation": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The identifier of the delegation that names the sender as its delegate, and whose vault paid for the job"
        },
        "document": {
          "type": "object",
          "required": [
            "schema",
            "request_number",
            "tenant",
            "order_id",
            "patient_ref",
            "ordering_clinician_ref",
            "service_code",
            "diagnosis_codes",
            "justification",
            "guideline_refs",
            "record_refs",
            "record_set_sha256",
            "insurer_did",
            "advert_ref"
          ],
          "additionalProperties": false,
          "properties": {
            "schema": {
              "const": "vector.usecase.priorauth-request.v1"
            },
            "request_number": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
              "description": "The number of the request: the tenant, a hyphen and a counter. The insurer portal files one entry for each number, without regard to case"
            },
            "tenant": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
              "description": "The tenant of the mock systems: 1 to 48 characters, lower-case letters, digits and hyphens, starting with a letter or a digit"
            },
            "order_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
              "description": "The identifier of the clinical order"
            },
            "patient_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
              "description": "A synthetic reference. No patient exists behind it"
            },
            "ordering_clinician_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
              "description": "The reference of the ordering clinician, from the order"
            },
            "service_code": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
              "description": "The code of the service that the order asks for"
            },
            "diagnosis_codes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              "description": "The diagnosis codes of the order: 1 to 8 codes of 1 to 16 UTF-16 code units each, with no control, format or separator character"
            },
            "justification": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "description": "The reasons for the service: 1 to 4000 characters, with no control or hidden character but the line feed"
            },
            "guideline_refs": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                "description": "The identifier of a criterion of the guideline that the justification cites"
              },
              "description": "The criteria that the justification cites, none twice"
            },
            "record_refs": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                "description": "The identifier of a record that the justification cites"
              },
              "description": "The records that the justification cites, none twice"
            },
            "record_set_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "The SHA-256 of the record set that the request draws on"
            },
            "insurer_did": {
              "type": "string",
              "pattern": "^did:vector:[0-9a-f]{64}$",
              "description": "The DID of the insurer that the request is for: this agent"
            },
            "advert_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}#[0-9]{1,10}$",
              "description": "The reference of the advert of this agent that the escrow of the request was posted on"
            }
          }
        },
        "salt": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The salt of the proposal that the provider signed off"
        },
        "approval": {
          "description": "The sign-off of the provider's reviewer for the digest of the salt and the document, or null: this agent refuses a request with no valid sign-off",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "attestation",
                "issuer_did"
              ],
              "additionalProperties": false,
              "properties": {
                "attestation": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "issuer_did": {
                  "type": "string",
                  "pattern": "^did:vector:[0-9a-f]{64}$"
                }
              }
            }
          ]
        }
      }
    },
    "response_schema": {
      "$ref": "https://github.com/Apex-Fusion/vector-service-agents/blob/main/specs/insurer-intake-agent.md#response"
    },
    "routes": {
      "job": "/v1/job",
      "status": "/status",
      "capability": "/capability"
    },
    "notes": [
      "The request is the handoff of use case 2 (prior authorization): its use case is prior-authorization, and its document is an authorization request. A handoff for another use case, and a document that is not an authorization request, are refused with bad_shape (400).",
      "Before the runtime claims the escrow, the service checks the sender, the delegation, the payment from a vault and the sign-off of the provider, and then that the request is for this insurer, that it names the advert that the escrow was posted on, and that its request number is new. A check that fails is a refusal with its code (403), and the escrow stays open. A source that cannot be read is 503 check_unavailable.",
      "After the Claim, the service reads the requirements of the insurer portal and reports the provenance, software and principal-binding attestations of the sender, without refusing on them. The model decides whether the request is complete. The service files the request in the insurer portal, complete or not, and returns an intake record.",
      "The advert and every receipt name the model insurer-intake-agent-v1. The receipt commits to the SHA-256 of the intake record as the service returns it.",
      "The intake record is an intake decision. It is not a coverage decision."
    ]
  },
  "terms": {
    "price_lovelace": 2000000,
    "supplier_bond_lovelace": 1000000,
    "buyer_bond_lovelace": 1000000,
    "max_processing_ms": 480000,
    "input_limits": {
      "request_bytes": 900000
    }
  },
  "behaviour": {
    "data_handling": "The authorization request, the sign-off reference and the requirements are synthetic data. They are held in memory while a job runs, and none of them is kept after the job. The filed request lives in the insurer portal of the mock service. On disk the service keeps the bookkeeping of the escrows that it posts for its model call, the book of the request numbers that it filed (the tenant, the request number and the intake id of each request), and the journal of its challenges. On a digest mismatch it publishes an evidence document and a challenge on the ledger. The log carries job outcomes, counts and codes, never a request, a requirement or a key.",
    "third_parties": [
      "the identity gateway (the resolution of the DID of the sender, and the request for the JWT-SVID)",
      "the ledger, read only (the delegation, the escrow paid from a vault, the sign-off and the other attestations of the sender)",
      "the insurer portal of the mock service (the read of the requirements and the filing of the request, with the JWT-SVID)",
      "a model supplier on the Vector marketplace, hired through a bonded escrow, and the model provider behind it (the prompt of the decision: the members ordering_clinician_ref, diagnosis_codes, justification, guideline_refs, record_refs and record_set_sha256 of the request, and the requirements, and no other member of the request)",
      "the Vector ledger (the escrow of each model hire, which carries only hashes, and, after a digest mismatch, the evidence document and the challenge)"
    ],
    "claim": {
      "statements": [
        {
          "id": "S1",
          "text": "This agent issues an intake record only for a request with a valid sign-off by the party whose delegation paid for it."
        },
        {
          "id": "S2",
          "text": "An intake record names the hash of the request this agent received."
        },
        {
          "id": "S3",
          "text": "This agent files one entry per request number."
        }
      ]
    },
    "fault_modes": [],
    "model": {
      "allowlist": [
        "deepseek/deepseek-v4-flash"
      ],
      "max_price_lovelace": 1000000
    },
    "relying_on": {
      "mock_systems": [
        "GET /t/{tenant}/insurer/requirements/{service_code}",
        "POST /t/{tenant}/insurer/requests"
      ],
      "gateway_routes": [
        "POST /spiffe/jwt-svid",
        "GET /1.0/identifiers/{did}"
      ]
    }
  },
  "status": {
    "chip": "proposed",
    "since": "2026-11-24"
  },
  "gaps": [
    "An intake record is not a coverage decision.",
    "The model decides completeness. Nothing in this agent overrides it.",
    "The checks read the ledger and the gateway as they are at that moment.",
    "The sender's organisation and its provenance, software and principal-binding attestations are reported, not required.",
    "A request refused is not paid, and leaves no signed record of the refusal except, on a digest mismatch, the evidence of the challenge.",
    "Every request is synthetic.",
    "The report does not check the digest of the principal-binding attestation, because the salt and the document stay with the hirer.",
    "A source that cannot be read is reported as unreadable and never as absent.",
    "The controller key, the Accountable key and the guardian keys of this deployment are on one host of one operator, so a party is independent of the controller by key only.",
    "What this does not show: no run covers the refund of the escrow of a revoked agent, a relying party that refuses a live token after its authority ended, or the challenge of the Prior Authorization Agent against this agent (this agent has no fault value). Tests alone cover the last two."
  ],
  "links": {
    "spec": "https://github.com/Apex-Fusion/vector-service-agents/blob/main/specs/insurer-intake-agent.md",
    "source": "https://github.com/Apex-Fusion/vector-service-agents/tree/main/agents/insurer-intake-agent",
    "explorer_advert": ""
  }
}

{
  "schema": "vector.agent-manifest.v1",
  "name": "Agent History",
  "capability_id": "identity.history.report.v1",
  "version": "0.1.0",
  "description": "Everything the Vector ledger knows about one agent identifier, as one signed report. Read-only; no model cost.",
  "operator": {
    "name": "Apex Fusion Foundation",
    "contact": "filip.blagojevic@foundation.apexfusion.org"
  },
  "identity": {
    "did": "<AGENT_DID>",
    "controller_pkh": "<SUPPLIER_PKH>",
    "registry_address": "addr1wxlp5z3fztdpsp6ha57dvx6khw82kqvgcxwu8s8rjykjcqghprf42"
  },
  "keys": {
    "supplier_pkh": "<SUPPLIER_PKH>",
    "pub_key_hex": "<SUPPLIER_PUB_KEY_HEX>"
  },
  "interface": {
    "request_schema": {
      "type": "object",
      "required": [
        "subject"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "description": "DID, registry asset name (64 hex) or key hash (56 hex)"
        },
        "include": {
          "type": "array",
          "items": {
            "enum": [
              "identity",
              "marketplace",
              "reputation",
              "dispute",
              "self_improvement"
            ]
          }
        }
      }
    },
    "response_schema": {
      "$ref": "https://github.com/Apex-Fusion/vector-service-agents/blob/main/specs/agent-history.md#response"
    },
    "routes": {
      "job": "/v1/job",
      "status": "/status",
      "capability": "/capability"
    }
  },
  "terms": {
    "price_lovelace": 1000000,
    "supplier_bond_lovelace": 1000000,
    "buyer_bond_lovelace": 1000000,
    "max_processing_ms": 300000,
    "input_limits": {
      "request_bytes": 65536
    }
  },
  "behaviour": {
    "data_handling": "Reads public ledger data only; the request subject is kept in memory for at most 60 s (expired entries are purged lazily).",
    "third_parties": [
      "Koios (Vector mainnet indexer)",
      "marketplace indexer",
      "the subject agent's own endpoint (one GET /capability, 64 KiB cap, 20 s budget)"
    ]
  },
  "status": {
    "chip": "proposed",
    "since": "2026-10-13"
  },
  "gaps": [
    "Escrow rows come from the marketplace indexer, one per escrow UTxO version: a job appears once for each state it reached (Open, Claimed, Submitted), so up to three times, and never as Accepted, Released or Reclaimed. The report gives by_indexer_state counts and, for the latest 50 rows per side, how many are spent on the ledger (latest_checked, latest_spent). It gives no outcome counts: Accept, Release and Reclaim are not told apart.",
    "Module-1 and Module-6 matched generically"
  ],
  "links": {
    "spec": "https://github.com/Apex-Fusion/vector-service-agents/blob/main/specs/agent-history.md",
    "source": "https://github.com/Apex-Fusion/vector-service-agents/tree/main/agents/agent-history",
    "explorer_advert": ""
  }
}

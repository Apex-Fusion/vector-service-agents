{
  "schema": "vector.agent-manifest.v2",
  "name": "Prior Authorization Agent",
  "capability_id": "health.priorauth.draft.v1",
  "version": "0.1.0",
  "description": "For a care provider: reads the records behind a clinical order, drafts an insurer-format authorization request with its justification, and, once the provider's reviewer has signed off, submits exactly that request to the insurer's intake agent.",
  "operator": {
    "name": "Apex Fusion Foundation",
    "contact": "<OPERATOR_CONTACT>"
  },
  "identity": {
    "did": "<AGENT_DID>",
    "registry_address": "",
    "supplier_key": "<AGENT_DID>#<SUPPLIER_PKH>"
  },
  "keys": {
    "supplier_pkh": "<SUPPLIER_PKH>",
    "pub_key_hex": "<SUPPLIER_PUB_KEY_HEX>",
    "buyer_pkh": "<PRIORAUTH_SERVICE_PKH>",
    "delegation_pkhs": [
      "<PRIORAUTH_DELEGATION_1_PKH>",
      "<PRIORAUTH_DELEGATION_2_PKH>"
    ]
  },
  "interface": {
    "request_schema": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "authority",
            "tenant",
            "order_id",
            "insurer_did"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "propose"
            },
            "authority": {
              "type": "object",
              "required": [
                "principal_did",
                "delegation"
              ],
              "additionalProperties": false,
              "properties": {
                "principal_did": {
                  "type": "string",
                  "pattern": "^did:vector:[0-9a-f]{64}$",
                  "description": "The DID of the principal who gave the delegation"
                },
                "delegation": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "The identifier of the delegation that names this agent as its delegate"
                }
              }
            },
            "tenant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48,
              "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
              "description": "The tenant of the mock systems: 1 to 48 characters, lower-case letters, digits and hyphens, starting with a letter or a digit"
            },
            "order_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
              "description": "The clinical order to draft the authorization request for: 1 to 64 characters"
            },
            "insurer_did": {
              "type": "string",
              "pattern": "^did:vector:[0-9a-f]{64}$",
              "description": "The DID of the Insurer Intake Agent that takes the request"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "authority",
            "tenant",
            "proposal",
            "approval"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "execute"
            },
            "authority": {
              "type": "object",
              "required": [
                "principal_did",
                "delegation"
              ],
              "additionalProperties": false,
              "properties": {
                "principal_did": {
                  "type": "string",
                  "pattern": "^did:vector:[0-9a-f]{64}$",
                  "description": "The DID of the principal who gave the delegation"
                },
                "delegation": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "The identifier of the delegation that names this agent as its delegate"
                }
              }
            },
            "tenant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48,
              "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
              "description": "The tenant of the mock systems: 1 to 48 characters, lower-case letters, digits and hyphens, starting with a letter or a digit"
            },
            "proposal": {
              "type": "object",
              "required": [
                "document",
                "salt",
                "proposal_digest"
              ],
              "additionalProperties": false,
              "properties": {
                "document": {
                  "type": "object",
                  "description": "The authorization request that propose returned"
                },
                "salt": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "proposal_digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "The digest of the salt and the document, which the hirer signed off"
                }
              }
            },
            "approval": {
              "description": "The sign-off of the hirer for the digest of the proposal, or null: the Insurer Intake Agent refuses a request with no valid sign-off",
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "attestation",
                    "issuer_did"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "attestation": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "issuer_did": {
                      "type": "string",
                      "pattern": "^did:vector:[0-9a-f]{64}$"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "response_schema": {
      "$ref": "https://github.com/Apex-Fusion/vector-service-agents/blob/main/specs/prior-authorization-agent.md#response"
    },
    "routes": {
      "job": "/v1/job",
      "status": "/status",
      "capability": "/capability"
    },
    "notes": [
      "A request is one JSON object with the member op set to propose or to execute, with the members of that operation and no other member. A request that breaks a rule of the intake is refused with bad_shape (400).",
      "propose reads the order and its record set through a sub-delegation to record-reader, reads the guideline of the service through a sub-delegation to drafter, asks one model for the justification, and returns an authorization request with its salt and its digest. It writes nothing to the records system and pays the Insurer Intake Agent nothing.",
      "execute submits a request that the hirer signed off: it pays the advert of the Insurer Intake Agent from the vault of the delegation, checks the intake record, asks one model whether to accept it, accepts the escrow and writes the intake reference to the records system. An intake record that the model does not accept is challenged and not accepted.",
      "The route POST /cosign/delegate is open and takes no job: it signs only the Delegate that the rule in behaviour.cosign allows, for a principal key on the allowlist of the operator.",
      "The advert and every receipt name the model prior-authorization-agent-v1."
    ]
  },
  "terms": {
    "price_lovelace": 3000000,
    "supplier_bond_lovelace": 1000000,
    "buyer_bond_lovelace": 1000000,
    "max_processing_ms": 1800000,
    "input_limits": {
      "request_bytes": 900000,
      "order_id_chars": 64,
      "tenant_chars": 48,
      "justification_chars": 4000
    }
  },
  "behaviour": {
    "data_handling": "The order, the record set, the guideline, the authorization request and the intake record are synthetic data, and they are held in memory while a job runs. On disk the service keeps the bookkeeping of the escrows that it posts, the list of sub-delegations that it has to end, the record of the challenges that it files, the register of the transactions that it co-signed, and the counter of request numbers. The log carries job outcomes, counts and codes, never a record, a justification, a request or a key.",
    "third_parties": [
      "the identity gateway (the token requests of the agent and of its two subagents, record-reader and drafter)",
      "the mock records system and guidelines store (the three calls that behaviour.relying_on lists, with their tokens)",
      "a model supplier on the Vector marketplace, hired through a bonded escrow, and the model provider behind it (the prompt of the decision justification: the order without its patient reference and its clinician reference, the whole record set and the guideline; the prompt of the decision accept_delivery: the request number and the hash of the request that was sent, and the request number and the hash that the intake record names)",
      "the Insurer Intake Agent (the request, the salt, the approval reference, the DID of this agent and the delegation)",
      "the Vector ledger (the two sub-delegations, the escrows, which carry only hashes, and, on a dispute, the evidence document and the challenge)"
    ],
    "operations": [
      "propose",
      "execute"
    ],
    "claim": {
      "statements": [
        {
          "id": "S1",
          "text": "A request this agent submits is byte-identical to the document whose digest its hirer approved."
        },
        {
          "id": "S2",
          "text": "The record set hash in a request is the hash of the set its drafter was given."
        },
        {
          "id": "S3",
          "text": "This agent reads records and guidelines only through its subagents, each with its own token under its own sub-delegation."
        }
      ]
    },
    "cosign": {
      "route": "/cosign/delegate",
      "rule": "The agent signs one kind of transaction: a Delegate transaction of the delegation contract that names this agent as the delegate and one of its own delegation keys as the delegate key. The delegator must have signed the transaction first, and the delegator must be a principal key on the allowlist of the operator. The delegation key must have no live delegation and no other signed transaction whose window is open. The transaction must spend nothing of the agent, and it must have no certificate, no withdrawal and no other mint. Its validity window must end in the future, and not too far ahead, and the period of the delegation must not be over. The agent adds one witness of the delegation key and changes nothing else."
    },
    "fault_modes": [
      "alter_after_approval"
    ],
    "model": {
      "allowlist": [
        "deepseek/deepseek-v4-flash"
      ],
      "max_price_lovelace": 1000000
    },
    "relying_on": {
      "mock_systems": [
        "GET /t/{tenant}/records/orders/{order_id}",
        "GET /t/{tenant}/guidelines/{code}",
        "POST /t/{tenant}/records/orders/{order_id}/submission"
      ],
      "gateway_routes": [
        "POST /token"
      ]
    }
  },
  "status": {
    "chip": "proposed",
    "since": "2026-11-24"
  },
  "gaps": [
    "Every record is synthetic. Nothing here has been run against a real records system or a real insurer.",
    "The model writes the justification. Nothing in this agent checks it against the guideline.",
    "This agent does not check the sign-off of the hirer. The Insurer Intake Agent does.",
    "The subagent drafter is given the whole record set, but nothing forces the model to use all of it. The request carries the hash of the set so that a reviewer can compare.",
    "A challenge puts a hold on the identity of the Insurer Intake Agent if the jury finds for this agent. It does not return what the escrow locked: a delivery that this agent refuses can still be released to the Insurer Intake Agent 600 s after its Submit.",
    "A model call that fails ends the job. There is no second provider.",
    "The insurer side is operated by the same foundation as this agent.",
    "The controller key, the Accountable key and the guardian keys of this deployment are held on one host by one operator, so a party is independent of the controller by key only.",
    "What this does not show: no run covers the refund of the escrow of a revoked agent, a relying party that refuses a live token after its authority ended, or a challenge of this agent against the Insurer Intake Agent, because that agent has no fault value. Tests alone cover the last two.",
    "This service has a fault switch for failure runs with these possible values: alter_after_approval (in execute, one sentence of the justification changes before the handoff, so its digest differs from the approved digest); this manifest is the same for every value, so only the field fault_mode of each result shows which value is active."
  ],
  "links": {
    "spec": "https://github.com/Apex-Fusion/vector-service-agents/blob/main/specs/prior-authorization-agent.md",
    "source": "https://github.com/Apex-Fusion/vector-service-agents/tree/main/agents/prior-authorization-agent",
    "explorer_advert": ""
  }
}

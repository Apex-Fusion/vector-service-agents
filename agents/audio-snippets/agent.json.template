{
  "schema": "vector.agent-manifest.v1",
  "name": "Audio Snippets",
  "capability_id": "audio.transcript.snippets.v1",
  "version": "0.1.0",
  "description": "A word-timed transcript of an audio or video file, plus the cut points for the quotes or the question you give it, and optionally the cut clips.",
  "operator": {
    "name": "Apex Fusion Foundation",
    "contact": "<OPERATOR_CONTACT>"
  },
  "identity": {
    "did": "<AGENT_DID>",
    "controller_pkh": "<SUPPLIER_PKH>",
    "registry_address": "addr1wxlp5z3fztdpsp6ha57dvx6khw82kqvgcxwu8s8rjykjcqghprf42"
  },
  "keys": {
    "supplier_pkh": "<SUPPLIER_PKH>",
    "pub_key_hex": "<SUPPLIER_PUB_KEY_HEX>"
  },
  "interface": {
    "request_schema": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "description": "The media: an https URL of an audio or video file (at most 52428800 bytes), or the file itself as base64 with its type",
          "oneOf": [
            {
              "type": "object",
              "required": [
                "url"
              ],
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 9,
                  "pattern": "^https://",
                  "description": "An https URL; the service fetches it itself"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "audio_b64",
                "mime"
              ],
              "additionalProperties": false,
              "properties": {
                "audio_b64": {
                  "type": "string",
                  "minLength": 4,
                  "maxLength": 800000,
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                  "description": "The media as standard base64 text, padded, with no line breaks; at most 600000 bytes of media"
                },
                "mime": {
                  "enum": [
                    "audio/mpeg",
                    "audio/mp4",
                    "audio/x-m4a",
                    "audio/wav",
                    "audio/x-wav",
                    "audio/ogg",
                    "audio/flac",
                    "audio/webm",
                    "video/mp4",
                    "video/webm",
                    "video/quicktime"
                  ]
                }
              }
            }
          ]
        },
        "language": {
          "type": "string",
          "anyOf": [
            {
              "pattern": "^[Aa][Uu][Tt][Oo]$"
            },
            {
              "maxLength": 16,
              "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
            }
          ],
          "default": "en",
          "description": "The language of the speech: auto, or a language code such as en or en-GB, 2 to 8 letters and optional hyphen-separated subtags of up to 8 letters or digits, at most 16 characters"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "A question in words, matched by keyword overlap at segment level"
        },
        "quotes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": "Quotes as they were said, or nearly: each one is matched once, where it is said first"
        },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "start_s",
              "end_s"
            ],
            "additionalProperties": false,
            "properties": {
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "description": "Time ranges in seconds, taken as given, each with the words inside it"
        },
        "return_clips": {
          "type": "boolean",
          "default": false,
          "description": "Cut a clip for each match"
        },
        "clip_format": {
          "enum": [
            "mp3",
            "wav"
          ],
          "default": "mp3",
          "description": "The format of the clips: mp3 at 64 kbps or 16 kHz mono wav, only with return_clips true"
        }
      },
      "anyOf": [
        {
          "properties": {
            "query": true
          },
          "required": [
            "query"
          ]
        },
        {
          "properties": {
            "quotes": true
          },
          "required": [
            "quotes"
          ]
        },
        {
          "properties": {
            "ranges": true
          },
          "required": [
            "ranges"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "clip_format": true
            },
            "required": [
              "clip_format"
            ]
          },
          "then": {
            "properties": {
              "return_clips": {
                "const": true
              }
            },
            "required": [
              "return_clips"
            ]
          }
        }
      ]
    },
    "response_schema": {
      "$ref": "https://github.com/Apex-Fusion/vector-service-agents/blob/main/specs/audio-snippets.md#response"
    },
    "routes": {
      "job": "/v1/job",
      "status": "/status",
      "capability": "/capability"
    },
    "notes": [
      "A quote and the query must each hold at least one letter or digit, and a range must start before it ends; a range that ends after the media is refused with range_out_of_media (422) once the media is read.",
      "The language is auto, or a code whose first part is one of the 100 the speech model knows: af, am, ar, as, az, ba, be, bg, bn, bo, br, bs, ca, cs, cy, da, de, el, en, es, et, eu, fa, fi, fo, fr, gl, gu, ha, haw, he, hi, hr, ht, hu, hy, id, is, it, ja, jw, ka, kk, km, kn, ko, la, lb, ln, lo, lt, lv, mg, mi, mk, ml, mn, mr, ms, mt, my, ne, nl, nn, no, oc, pa, pl, ps, pt, ro, ru, sa, sd, si, sk, sl, sn, so, sq, sr, su, sv, sw, ta, te, tg, th, tk, tl, tr, tt, uk, ur, uz, vi, yi, yo, zh, yue. Any other is refused with language_unsupported (400).",
      "A source URL must be https and public and must not redirect: the service fetches it itself, at most 52428800 bytes, reads the type of the media from its first bytes, and refuses one that differs from the type the request declared or the server served (source_mime_mismatch, 422)."
    ]
  },
  "terms": {
    "price_lovelace": 2000000,
    "supplier_bond_lovelace": 1000000,
    "buyer_bond_lovelace": 1000000,
    "max_processing_ms": 1500000,
    "input_limits": {
      "request_bytes": 900000,
      "source_bytes": 52428800,
      "inline_media_bytes": 600000,
      "duration_s": 600,
      "query_chars": 500,
      "quotes": 20,
      "quote_chars": 300,
      "ranges": 20,
      "inline_clip_bytes": 2000000
    }
  },
  "behaviour": {
    "data_handling": "The media, the language, the query, the quotes and the ranges are held in memory while a job runs; the media is also written to a private temporary directory, with its decode to 16 kHz WAV and each clip while it is cut, and the directory is removed when the job ends. The speech model runs in the service from files built into its image, so nothing leaves but the fetch of the media from the host of its URL. On the ledger the escrow carries only the sha256 of the wire payload, and the media stays off the ledger. The log carries job outcomes, never a request, a transcript or the media.",
    "third_parties": [
      "the host of the source URL"
    ]
  },
  "status": {
    "chip": "proposed",
    "since": "2026-10-13"
  },
  "gaps": [
    "At most 10 min and 50 MB per file, and one of query, quotes, ranges is required.",
    "The transcript is only as good as the speech model, faster-whisper base int8 on CPU: names, numbers and quiet or overlapping speech can come out wrong, and every match is made against what the model heard.",
    "The language is taken as asked: audio in another language is transcribed as if it were in the one asked for, and its quotes go to unmatched. With auto the model detects the language from the first 30 s.",
    "A query is matched by keyword overlap at segment level, and the result says so in match_method: a question worded otherwise than the speech finds nothing, and no embedding model is installed.",
    "A quote is matched once: a quote said twice gives one match, where it is said first.",
    "Clips carry their bytes inline only while their total stays at or under 2000000 bytes: past that, a clip carries its sha256, its size and its cut points, and clips_truncated is true.",
    "A job has a deadline of its own, 1320000 ms after its request arrives, and the speech recognition gets at most 900000 ms of it: a job cut at the deadline fails with the code deadline and returns no result."
  ],
  "links": {
    "spec": "https://github.com/Apex-Fusion/vector-service-agents/blob/main/specs/audio-snippets.md",
    "source": "https://github.com/Apex-Fusion/vector-service-agents/tree/main/agents/audio-snippets",
    "explorer_advert": ""
  }
}

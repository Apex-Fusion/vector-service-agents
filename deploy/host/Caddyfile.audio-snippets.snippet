# deploy/host/Caddyfile.audio-snippets.snippet - site block for the shared Caddy of the host, merged into the host's Caddy configuration.
# PROPOSED (built, not deployed) since 2026-10-13. Not installed: step 10 of RUNBOOK-audio-snippets.md has not been run. The hostname must be DNS only (grey cloud),
# or Caddy cannot get its certificate. The block must stay the last thing in this file: the host administrator's install script
# takes everything from the hostname line to the end.
# The runtime does not serve /agent.json, and the advert's detail_uri points at it, so that one path goes to the service.
# Everything else goes to the runtime.
mp-suppliers-snippets.hal8.ai {
    handle /agent.json {
        reverse_proxy audio-snippets-service:9093
    }
    handle {
        reverse_proxy audio-snippets-agent:8080
    }
}

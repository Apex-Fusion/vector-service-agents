# deploy/host/Caddyfile.snippet - site block for the shared Caddy of the host, merged into the host's Caddy configuration.
# DEPLOYED since 2026-10-15: installed and running on the box. It was installed on 2026-10-14 by the host administrator's install script (install-caddy-route.sh, in the ops folder of Agent History), which merges it and reloads Caddy (README.md). The hostname must be DNS only (grey cloud),
# or Caddy cannot get its certificate. The block must stay the last thing in this file: the host administrator's install script
# takes everything from the hostname line to the end.
# The runtime does not serve /agent.json, and the advert's detail_uri points at it, so that one path goes to the service.
# Everything else goes to the runtime.
mp-suppliers-history.hal8.ai {
    handle /agent.json {
        reverse_proxy agent-history-service:9091
    }
    handle {
        reverse_proxy agent-history-agent:8080
    }
}

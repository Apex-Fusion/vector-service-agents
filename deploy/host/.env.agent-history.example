# Copy to .env.agent-history next to the compose file (mode 600). Names and placeholders only: this file holds no key, token or secret.
# The external network of the host's reverse proxy is not named here: compose reads PROXY_NETWORK from .env next to the compose file (RUNBOOK.md step 1).
# Identity (from gen-keypair on the box)
SUPPLIER_PRIV_KEY_HEX=
SUPPLIER_PUB_KEY_HEX=
SUPPLIER_PKH=
SUPPLIER_ADDRESS=
# Chain
NETWORK_ID=1
OGMIOS_URL=https://ogmios.vector.mainnet.apexfusion.org
VECTOR_ZERO_TIME_MS=1756485600000
LIVE_CHAIN=1
ESCROW_REF_UTXO=c8d84c6d67ec67a1efe5e9c6c06d53020e05d1bb96d1c55ecb1eb7d5010c4d54#0
ADVERT_REF_UTXO=c8d84c6d67ec67a1efe5e9c6c06d53020e05d1bb96d1c55ecb1eb7d5010c4d54#1
# The escrow and the advert that carry an agent_id (the runtime): the reference scripts that the identity registry deployment on Vector mainnet published
# on 2026-11-03. Keep ESCROW_REF_UTXO and ADVERT_REF_UTXO above while legacy escrows exist. The runtime works an escrow that names the agent only with
# IDENTITY_POLICY_ID (below) and AGENT_ID, the identifier of the agent's record (64 hex): the step that makes the record writes AGENT_ID into this file.
IDENTITY_ESCROW_REF_UTXO=4c2d09858dab0cc22cc77dcb99efed570d909a66e0beb512041dea91005b5e82#0
IDENTITY_ADVERT_REF_UTXO=5efd18a1d90a6b87f1fd4b6fe93acfbe5be082260fd52be194b1088ade7c2758#0
# Advert (filled by post-advert)
ADVERT_REF=
ADVERT_CAPABILITY_ID=identity.history.report.v1
ADVERT_MODEL=agent-history-v1
ADVERT_PRICE_LOVELACE=1000000
ADVERT_SUPPLIER_BOND_LOVELACE=1000000
ADVERT_BUYER_BOND_LOVELACE=1000000
ADVERT_MAX_PROCESSING_MS=300000
ADVERT_ENDPOINT_URL=https://mp-suppliers-history.hal8.ai
ADVERT_DETAIL_URI=https://mp-suppliers-history.hal8.ai/agent.json
ADVERT_DETAIL_HASH=
# Manifest (service). What the service serves at /agent.json is hashed into the advert, so every line in this block, and the three
# identity lines above, must be final before the hash is taken. A change afterwards means a retired advert and a new one.
# Left unset on purpose: AGENT_VERSION (the service has its own default).
# OPERATOR_CONTACT is required: the service stops at start without it, and the value is published in the manifest. There is no default. Replace the
# placeholder with the role address the Foundation confirms, never a person's address (RUNBOOK.md step 4, "Make the env file and generate the supplier key").
OPERATOR_CONTACT=<role address, e.g. ecosystem@<foundation domain>; the Foundation confirms which>
# AGENT_DID is written by the register step (RUNBOOK.md step 7, "Register the identity"), which refuses to run while this empty line is here. Remove the line first.
AGENT_DID=
# The status word the manifest carries, and since when: deployed since 2026-10-15, after the advert was Active and a first-party job had settled (RUNBOOK.md step 17, "Flip the status"). A first-party run is not demand, so the word is not live.
# On a first run, before any job has settled, set proposed and today's date here; step 17 changes them.
AGENT_STATUS_CHIP=deployed
AGENT_STATUS_SINCE=2026-10-15
# Stays empty: the advert's own transaction id cannot be inside the manifest the advert hashes.
ADVERT_EXPLORER_URL=
# Report (service): the registries and the module addresses that the report reads (agents/agent-history/README.md, "Settings of the report").
# IDENTITY_POLICY_ID holds the policy ID that the identity registry deployment on Vector mainnet published on 2026-11-03, and the runtime reads it too.
# The other lines are empty here. An empty value keeps the default of the code: the module addresses of before the identity registry, and with an empty
# IDENTITY_POLICY_ID the legacy registry only.
# The service reads these values at start. A value that breaks a rule stops the service at start, and the error names the variable.
# IDENTITY_POLICY_ID: the policy ID of the identity registry, 56 lowercase hex characters, as its deployment publishes it. With it, the report reads both registries.
# The manifest publishes the address of this policy as identity.registry_address, so the value must be final before the hash is taken (RUNBOOK.md step 11). A change afterwards means a retired advert and a new one.
IDENTITY_POLICY_ID=d958b823faaa76977d0a07bd9622e87d8e2c85f6692f7f8e8db77762
# IDENTITY_ADDRESS: the address of the identity registry. Empty means the address of IDENTITY_POLICY_ID. A value needs IDENTITY_POLICY_ID and must be the address of that policy.
IDENTITY_ADDRESS=
# M3_REPUTATION_ADDRESS and M3_ENDORSEMENT_ADDRESS: the Module-3 stake address and the Module-3 endorsement address. Each is one Vector mainnet script address (addr1...).
M3_REPUTATION_ADDRESS=
M3_ENDORSEMENT_ADDRESS=
# M1_ADDRESSES and M6_ADDRESSES: the Module-1 and Module-6 addresses, as label=address pairs, comma separated with no space: <label>=<address>,<label>=<address>
# (the ops scripts read this file with the shell's ".", and a space after a comma would make the rest a command). Each address is a Vector mainnet script address.
# A label starts with a lowercase letter and has only lowercase letters, digits and _ (32 characters at most). The labels are the keys of the dispute and self_improvement sections, in this order. A list names no label and no address two times.
M1_ADDRESSES=
M6_ADDRESSES=
